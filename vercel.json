{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).(svg|png|jpg|webp|woff2|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": ".release",
  "framework": null,
  "functions": {
    "api/operations.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/operations",
      "schedule": "*/10 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/form-a",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/checkout",
      "has": [
        {
          "type": "query",
          "key": "key"
        }
      ],
      "destination": "/success?legacy=1",
      "permanent": false
    },
    {
      "source": "/checkout/order-received/:path*",
      "destination": "/success?legacy=1",
      "permanent": false
    },
    {
      "source": "/checkout/order-pay/:path*",
      "destination": "/contact?legacy-order=1",
      "permanent": false
    },
    {
      "source": "/checkout",
      "destination": "/apply",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/#application-details",
      "permanent": true
    },
    {
      "source": "/product/begin-your-application",
      "destination": "/#application-details",
      "permanent": true
    },
    {
      "source": "/my-account/:path*",
      "destination": "/contact?existing-applicant=1",
      "permanent": true
    }
  ]
}
